# Copy this file to .env and fill in your values. Never commit .env.

# Free mode (default): GitHub token with the "Models: read" permission, for GitHub Models.
# (github.com -> Settings -> Developer settings -> Fine-grained tokens). Not needed in GitHub Actions.
GITHUB_TOKEN=

# Only for provider "gemini" (needs billing): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Meta app -> Instagram API -> API setup with Instagram login -> Generate token
IG_ACCESS_TOKEN=
IG_USER_ID=

# https://www.pexels.com/api/ (free). Optional: background photos for the news card.
PEXELS_API_KEY=
